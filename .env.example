# Copy to .env in this directory and fill in real values.
# Never commit .env. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Datastores (docker compose up -d) ---
MONGODB_URI=mongodb://127.0.0.1:27017/dsa_arcade
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/dsa_arcade_test
REDIS_URL=redis://127.0.0.1:6379

# --- Auth ---
# Both secrets must be at least 32 characters and must differ from each other.
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Set to true only when served over HTTPS.
COOKIE_SECURE=false

# --- Limits ---
MAX_SOURCE_BYTES=50000
MAX_JSON_BODY=100kb
DEFAULT_TIME_LIMIT_MS=2000
DEFAULT_MEMORY_LIMIT_MB=128
MAX_ACTIVE_SUBMISSIONS_PER_USER=3

# --- Execution ---
EXECUTION_QUEUE_NAME=code-execution
EXECUTION_WORKER_CONCURRENCY=2
JUDGE_WORK_ROOT=
JUDGE_IMAGE_PYTHON=dsa-judge-python:3.12
JUDGE_IMAGE_NODE=dsa-judge-node:24
JUDGE_IMAGE_CPP=dsa-judge-cpp:14

# --- Seeded admin (npm run create-admin) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456
