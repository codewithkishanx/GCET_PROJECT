{
  "name": "@dsa/worker",
  "version": "0.1.0",
  "private": true,
  "description": "DSA Arcade execution worker: isolated Docker sandbox and judge",
  "main": "dist/worker.js",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "images:build": "docker build -t dsa-judge-python:3.12 images/python && docker build -t dsa-judge-node:24 images/node && docker build -t dsa-judge-cpp:14 images/cpp"
  },
  "dependencies": {
    "@dsa/shared": "*",
    "bullmq": "^6.7.7",
    "dotenv": "^18.0.10",
    "ioredis": "^5.4.1",
    "mongoose": "^9.12.2",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
